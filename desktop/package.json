{
  "name": "@stremio-offline/desktop",
  "private": true,
  "version": "0.4.93",
  "description": "Desktop client for connecting to Stremio Offline servers",
  "author": "Stremio Offline contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:renderer": "npm run build:desktop --prefix ../web",
    "dev": "npm run build --prefix .. && npm run build && npm run build:renderer && npm run stage:local-backend && electron .",
    "start": "npm run dev",
    "test": "tsx --test src/*.test.ts",
    "spike:utility": "electron spike/run.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "require-ffmpeg-win": "node scripts/require-ffmpeg-win.mjs",
    "stage:local-backend": "node scripts/stage-local-backend.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "build:ffmpeg": "bash scripts/build-ffmpeg.sh",
    "package:mac:arm64": "npm run build --prefix .. && npm run build && npm run build:renderer && npm run stage:local-backend && npm run build:ffmpeg && electron-builder --mac --arm64 --publish never",
    "package:win:x64": "npm run require-ffmpeg-win && npm run build --prefix .. && npm run build && npm run build:renderer && npm run stage:local-backend && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "22.15.30",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "build": {
    "appId": "com.stremiooffline.desktop",
    "productName": "Stremio Offline",
    "npmRebuild": false,
    "electronFuses": {
      "resetAdHocDarwinSignature": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true,
      "enableCookieEncryption": false
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "../node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "files": [
      "dist/**/*.js",
      "renderer/**",
      "runtime/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "Stremio-Offline-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "ffprobe",
            "BUILDINFO.txt",
            "licenses/**"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "Stremio-Offline-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "ffmpeg-win",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "BUILDINFO.txt",
            "licenses/**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stremio Offline",
      "deleteAppDataOnUninstall": false
    }
  }
}
