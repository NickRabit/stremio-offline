STREMIO_OFFLINE_PORT=8090
DOWNLOAD_PATH=./downloads
# Server data: account, addons, library artwork, and stats. On Synology, point
# this at a shared folder so it shows up in File Station and gets backed up.
DATA_PATH=./data
TZ=Europe/Prague
# User the process should run as. On Synology, read the folder owner from
# Container Manager: container terminal,  ls -n /downloads
PUID=1000
PGID=1000
# Once, chown the whole download folder. Slow on a large library.
FIX_PERMISSIONS=0
# How much to write to the log: DEBUG (requests, playback progress), INFO, WARN, ERROR.
# Visible in Settings -> Diagnostics and in `docker compose logs`.
LOG_LEVEL=INFO
# Max size of one log file; past this it is renamed to app.log.1.
LOG_MAX_BYTES=5242880
# How long to keep records. Older ones are dropped regularly; 0 disables cleanup.
LOG_RETENTION_DAYS=7
# Secure mode (Settings -> Privacy, on by default) has the server fetch and cache
# posters, backdrops and addon logos. This is how much disk that cache may take
# before the oldest images are dropped.
IMAGE_CACHE_MB=512
# Age in days at which a cached addon image is dropped even while the cache is under
# its limit. 0, the default, keeps the limit as the only rule.
IMAGE_CACHE_TTL_DAYS=0
# Thumbnails the server generates for the library (a frame from the video, the poster
# of the matched title) live under DATA_PATH/artwork. This caps that directory.
ARTWORK_CACHE_MB=256
# Days after which the scan re-reads a bound series from the catalogue, so its episode
# titles stay current. 0 switches the pass off; only libraries the interface opened pay it.
LIBRARY_META_TTL_DAYS=14
# Roots a library may be added from, comma separated. Empty keeps DOWNLOAD_PATH as the
# only one. A second disk is one more mount plus one more entry: mount it in compose.yml,
# then add it here. A folder outside this list can never become a library.
# LIBRARY_ROOTS=/downloads,/libraries/archive
# Allow a specific addon on the LAN. Safer than opening the whole private network.
# ALLOW_ADDON_HOSTS=192.168.1.50,nas.local
# Opens the whole private network. Turn on only when you know why.
ALLOW_PRIVATE_ADDONS=0
# 1 locks the instance for a shared demo: addons, settings, password and
# secret export become read-only. Default 0 keeps the full admin UI.
# Create the account and confirm sign-in, then set 1 and recreate the
# container — not merely restart.
RESTRICTED_MODE=0
# Addon requests are guarded per host: a cap on concurrent requests, and a pause
# after repeated failures so a dead addon fails fast instead of timing out on
# every search. ADDON_GUARD=0 turns both off.
ADDON_GUARD=1
ADDON_MAX_CONCURRENT=8
# Requests waiting for a free slot on one host; a full search fan-out fits in.
ADDON_MAX_QUEUE=256
# Gap between requests to one host. Off unless a provider asks for it.
ADDON_MIN_INTERVAL_MS=0
# Consecutive failures before the host is taken out of service, and for how long.
# Each further outage doubles the pause up to the maximum.
ADDON_BREAKER_FAILURES=5
ADDON_BREAKER_COOLDOWN_MS=30000
ADDON_BREAKER_MAX_COOLDOWN_MS=300000
# Optional software-transcode tuning (lower CRF = higher quality and load).
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
# Hardware VAAPI quality in CQP mode (lower = higher quality and bitrate).
VAAPI_QP=23
FFMPEG_READRATE=1.5
# Head start when remuxing only; higher values make seeking faster.
FFMPEG_READRATE_REMUX=3
# Hardware conversion through Intel QuickSync: start with the override file
#   docker compose -f compose.yml -f compose.synology.yml up -d --build
# In Container Manager, which does not support an override, uncomment the
# devices block in compose.yml instead and set both values below.
# VAAPI_DEVICE=/dev/dri/renderD128
# GID of the group that owns /dev/dri/renderD128 (in the container terminal:
# ls -n /dev/dri; on the NAS: stat -c "%g" /dev/dri/renderD128). Without it
# the process cannot open the device. Default 937 is videodriver on DSM 7.
# RENDER_GID=937
# If automatic driver selection fails, force iHD for Gemini Lake and newer,
# i965 for older Braswell. vainfo in the container prints what actually loaded.
# LIBVA_DRIVER_NAME=iHD
